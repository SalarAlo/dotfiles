{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "right": 2
        }
    },

    "display": {
        "size": {
            "binaryPrefix": "si"
        },
        "color": "blue",
        "separator": ": "
    },

    "modules": [
        {
            "type": "datetime",
            "key": "Date",
            "format": "{1}-{3}-{11}"
        },
        {
            "type": "datetime",
            "key": "Time",
            "format": "{14}:{17}:{20}"
        },


        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },


        {
            "type": "memory",
            "key": "RAM"
        },
        {
            "type": "disk",
            "key": "Disk",
            "folders": ["/"]
        }

    ]
}
