	"idle_inhibitor",
	"group/mobo_drawer",
	"hyprland/workspaces#rw",
	"tray",
	"mpris",
	],

"modules-center": [
	"clock#2",
	"group/notify",
	],

"modules-right": [
	"hyprland/window",
	"battery",
 	"group/audio",
	"custom/power",
	],
}
